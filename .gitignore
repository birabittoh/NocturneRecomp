.vs/
.vscode/
NocturneRecomp.code-workspace

# Build output
/out/
*.pdb
*.ilk
*.exp
*.lib
*.exe

# rexglue migration backups
CMakeLists.txt.bak
src/main.cpp.bak

# Generated recomp sources
/generated/

# Scratch outputs, e.g. the extracted achievement metadata scripts/font_coverage.py
# reads (see its header for the rexglue command that fills this in)
/build/

# Embedded fonts header, rebuilt from src/fonts/*.ttf by scripts/gen-fonts.py
/src/fonts.generated.h
/src/glyph_pack.generated.h
/src/lang.generated.h

# Embedded icon header/ico, rebuilt from assets/default.xex by scripts/gen-icon.py
/src/icon.generated.h
/src/icon.generated.ico

# Windows exe-icon resource script, rewritten by CMake with an absolute path
# to src/icon.generated.ico (see CMakeLists.txt)
/src/nocturnerecomp.generated.rc

# Project version header, rewritten from the nearest git tag on every CMake
# configure (see CMakeLists.txt)
/src/version.generated.h

# Runtime artifacts — binary, logs, and bundled shared libraries
/sdk/
/logs/
nocturnerecomp
nocturnerecomp.exe
nocturnerecomp.pdb
nocturnerecomp.toml
/*.so
/*.dll
/*.dylib
/vulkan/
/NocturneRecomp.app/
/pkg/
/pkg-dmg/

# Game package and assets extracted from it
# (the package itself and anything derived from it must NEVER be committed)
9F2DAA064D494AA82B43B65362C59E9B89A88F8F58
/game/
/assets/
!/assets/.gitkeep

# Title-update packages and anything extracted from them (copyrighted; the user
# supplies their own)
/TU_*
/update/
*.xexp

# Modding stuff
mods/
dumps/
extracted/

# Python caches
__pycache__/

# Third-party tools dropped by the user locally.
# Ignore the tree, but keep the scripts and README we wrote.
/tools/*
!/tools/README.md
!/tools/*.ps1

# Locally built libraries
/local/

